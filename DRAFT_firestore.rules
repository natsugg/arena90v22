rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (isVerified() && request.auth.token.email == 'hardsize@mail.ru') ||
        (isVerified() && request.auth.uid == '71d9n4gGrTUsC1Cy9Dc4Sb1RiZD2') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          isVerified() &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isStreamer() {
      return isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'streamer';
    }

    function canPublishTrack() {
      return isAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'streamer', 'expert', 'moderator']
      );
    }

    // =========================================================================
    // Validation Blueprint: CriteriaScores (5 parameters, 1..10)
    // =========================================================================
    function isValidScoreValue(val) {
      return val is number && val >= 1 && val <= 10;
    }

    function isValidCriteriaScores(scores) {
      return scores is map
        && scores.keys().hasAll(['lyrics', 'flow', 'production', 'identity', 'vibe'])
        && scores.keys().hasOnly(['lyrics', 'flow', 'production', 'identity', 'vibe'])
        && isValidScoreValue(scores.lyrics)
        && isValidScoreValue(scores.flow)
        && isValidScoreValue(scores.production)
        && isValidScoreValue(scores.identity)
        && isValidScoreValue(scores.vibe);
    }

    // =========================================================================
    // Validation Blueprint: User (/users/{userId})
    // =========================================================================
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'xp', 'voteWeight', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'avatarUrl', 'role', 'xp', 'level', 'voteWeight', 'reviewsCount', 'helpfulVotesReceived', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() >= 0 && data.avatarUrl.size() <= 500))
        && data.role is string && data.role.size() <= 20 && data.role in ['viewer', 'vip', 'moderator', 'expert', 'streamer', 'admin']
        && data.xp is number && data.xp >= -1000 && data.xp <= 10000000
        && (!('level' in data) || (data.level is number && data.level >= 1 && data.level <= 1000))
        && data.voteWeight is number && data.voteWeight >= 0.1 && data.voteWeight <= 10.0
        && (!('reviewsCount' in data) || (data.reviewsCount is number && data.reviewsCount >= 0 && data.reviewsCount <= 1000000))
        && (!('helpfulVotesReceived' in data) || (data.helpfulVotesReceived is number && data.helpfulVotesReceived >= -1000 && data.helpfulVotesReceived <= 1000000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Validation Blueprint: Track (/tracks/{trackId})
    // =========================================================================
    function isValidTrack(data, trackId) {
      return data.keys().hasAll([
          'id', 'title', 'artist', 'coverUrl', 'audioUrl',
          'submittedBy', 'submittedByName', 'isPriority',
          'status', 'communityVotesCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'artist', 'artistId', 'coverUrl', 'audioUrl', 'sourceUrl',
          'youtubeUrl', 'youtubeId', 'genre', 'duration', 'submittedBy', 'submittedByName',
          'isPriority', 'donationAmount', 'status',
          'expertScore', 'expertTotalScore', 'communityScore', 'communityTotalScore',
          'peopleScore', 'communityVotesCount', 'reviewsCount', 'metaScore',
          'currentRank', 'previousRank', 'lastRankUpdate', 'criteriaBreakdown',
          'createdAt', 'updatedAt'
        ])
        && data.id == trackId
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 120
        && (!('artistId' in data) || (data.artistId is string && data.artistId.size() >= 0 && data.artistId.size() <= 128))
        && data.coverUrl is string && data.coverUrl.size() >= 0 && data.coverUrl.size() <= 500
        && data.audioUrl is string && data.audioUrl.size() >= 1 && data.audioUrl.size() <= 500
        && (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() >= 0 && data.sourceUrl.size() <= 500))
        && (!('youtubeUrl' in data) || data.youtubeUrl == null || (data.youtubeUrl is string && data.youtubeUrl.size() >= 0 && data.youtubeUrl.size() <= 500))
        && (!('youtubeId' in data) || data.youtubeId == null || (data.youtubeId is string && data.youtubeId.size() >= 0 && data.youtubeId.size() <= 64))
        && (!('genre' in data) || (data.genre is string && data.genre.size() >= 0 && data.genre.size() <= 60))
        && (!('duration' in data) || (data.duration is number && data.duration >= 0 && data.duration <= 7200))
        && isValidId(data.submittedBy)
        && data.submittedByName is string && data.submittedByName.size() >= 1 && data.submittedByName.size() <= 80
        && data.isPriority is bool
        && (!('donationAmount' in data) || (data.donationAmount is number && data.donationAmount >= 0 && data.donationAmount <= 1000000))
        && data.status is string && data.status.size() <= 20 && data.status in [
          'pending', 'in_queue', 'queued', 'on_air', 'playing',
          'reviewing', 'reviewed', 'community_catalog', 'rejected'
        ]
        && (!('expertScore' in data) || data.expertScore == null || isValidCriteriaScores(data.expertScore))
        && (!('expertTotalScore' in data) || data.expertTotalScore == null || (data.expertTotalScore is number && data.expertTotalScore >= 1 && data.expertTotalScore <= 10))
        && (!('communityScore' in data) || data.communityScore == null || isValidCriteriaScores(data.communityScore))
        && (!('communityTotalScore' in data) || data.communityTotalScore == null || (data.communityTotalScore is number && data.communityTotalScore >= 1 && data.communityTotalScore <= 10))
        && (!('peopleScore' in data) || data.peopleScore == null || (data.peopleScore is number && data.peopleScore >= 1 && data.peopleScore <= 10))
        && data.communityVotesCount is number && data.communityVotesCount >= 0 && data.communityVotesCount <= 1000000
        && (!('reviewsCount' in data) || data.reviewsCount == null || (data.reviewsCount is number && data.reviewsCount >= 0 && data.reviewsCount <= 1000000))
        && (!('metaScore' in data) || data.metaScore == null || (data.metaScore is number && data.metaScore >= 0 && data.metaScore <= 100))
        && (!('currentRank' in data) || data.currentRank == null || (data.currentRank is number && data.currentRank >= 1 && data.currentRank <= 10000))
        && (!('previousRank' in data) || data.previousRank == null || (data.previousRank is number && data.previousRank >= 1 && data.previousRank <= 10000))
        && (!('lastRankUpdate' in data) || data.lastRankUpdate == null || data.lastRankUpdate is timestamp)
        && (!('criteriaBreakdown' in data) || data.criteriaBreakdown == null || isValidCriteriaScores(data.criteriaBreakdown))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Validation Blueprint: TrackReview (/tracks/{trackId}/reviews/{reviewId})
    // =========================================================================
    function isValidReview(data, trackId, reviewId) {
      return data.keys().hasAll([
          'id', 'trackId', 'authorId', 'authorName', 'authorRole',
          'voteWeight', 'scores', 'totalScore', 'text', 'helpfulCount', 'helpfulVoterIds', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'trackId', 'authorId', 'authorName', 'authorRole',
          'voteWeight', 'scores', 'totalScore', 'text', 'helpfulCount', 'helpfulVoterIds', 'createdAt'
        ])
        && data.id == reviewId
        && isValidId(data.id)
        && data.trackId == trackId
        && isValidId(data.trackId)
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.authorRole is string && data.authorRole.size() <= 20 && data.authorRole in ['viewer', 'vip', 'moderator', 'expert', 'streamer', 'admin']
        && data.voteWeight is number && data.voteWeight >= 0.1 && data.voteWeight <= 10.0
        && isValidCriteriaScores(data.scores)
        && data.totalScore is number && data.totalScore >= 1 && data.totalScore <= 10
        && data.text is string && data.text.size() >= 100 && data.text.size() <= 3000
        && data.helpfulCount is number && data.helpfulCount >= 0 && data.helpfulCount <= 1000000
        && data.helpfulVoterIds is list && data.helpfulVoterIds.size() <= 10000
        && (data.helpfulVoterIds.size() == 0 || (data.helpfulVoterIds[0] is string && data.helpfulVoterIds[0].size() <= 128))
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // Validation Blueprint: LiveSession (/live_sessions/{sessionId})
    // =========================================================================
    function isValidActiveTrackSnapshot(snap) {
      return snap is map
        && snap.keys().hasAll(['id', 'title', 'artist', 'coverUrl'])
        && snap.keys().hasOnly([
          'id', 'title', 'artist', 'coverUrl', 'genre',
          'youtubeUrl', 'youtubeId',
          'expertScore', 'expertTotalScore', 'communityTotalScore',
          'communityVotesCount', 'metaScore'
        ])
        && isValidId(snap.id)
        && snap.title is string && snap.title.size() >= 1 && snap.title.size() <= 120
        && snap.artist is string && snap.artist.size() >= 1 && snap.artist.size() <= 120
        && snap.coverUrl is string && snap.coverUrl.size() >= 0 && snap.coverUrl.size() <= 500
        && (!('genre' in snap) || snap.genre == null || (snap.genre is string && snap.genre.size() >= 0 && snap.genre.size() <= 60))
        && (!('youtubeUrl' in snap) || snap.youtubeUrl == null || (snap.youtubeUrl is string && snap.youtubeUrl.size() >= 0 && snap.youtubeUrl.size() <= 500))
        && (!('youtubeId' in snap) || snap.youtubeId == null || (snap.youtubeId is string && snap.youtubeId.size() >= 0 && snap.youtubeId.size() <= 64))
        && (!('expertScore' in snap) || snap.expertScore == null || isValidCriteriaScores(snap.expertScore))
        && (!('expertTotalScore' in snap) || snap.expertTotalScore == null || (snap.expertTotalScore is number && snap.expertTotalScore >= 0 && snap.expertTotalScore <= 10))
        && (!('communityTotalScore' in snap) || snap.communityTotalScore == null || (snap.communityTotalScore is number && snap.communityTotalScore >= 0 && snap.communityTotalScore <= 10))
        && (!('communityVotesCount' in snap) || snap.communityVotesCount == null || (snap.communityVotesCount is number && snap.communityVotesCount >= 0 && snap.communityVotesCount <= 1000000))
        && (!('metaScore' in snap) || snap.metaScore == null || (snap.metaScore is number && snap.metaScore >= 0 && snap.metaScore <= 100));
    }

    function isValidLiveSession(data, sessionId) {
      return data.keys().hasAll([
          'id', 'isLive', 'streamStatus', 'activeTrackId', 'hostId',
          'title', 'votingOpen', 'isPlaying', 'playbackPosition',
          'showObsOverlay', 'obsTheme', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'isLive', 'streamStatus', 'activeTrackId', 'activeTrackSnapshot',
          'youtubeUrl', 'youtubeId', 'showVideoInOverlay', 'streamKey',
          'hostId', 'title', 'votingOpen', 'isPlaying', 'isMuted', 'playbackPosition',
          'showObsOverlay', 'obsTheme', 'liveExpertDraft', 'viewersCount', 'updatedAt'
        ])
        && data.id == sessionId
        && isValidId(data.id)
        && data.isLive is bool
        && data.streamStatus is string && data.streamStatus.size() <= 20 && data.streamStatus in ['idle', 'listening', 'locked', 'revealed', 'offline', 'starting', 'voting', 'results', 'paused']
        && (data.activeTrackId == null || (data.activeTrackId is string && data.activeTrackId.size() >= 0 && data.activeTrackId.size() <= 128))
        && (!('activeTrackSnapshot' in data) || data.activeTrackSnapshot == null || isValidActiveTrackSnapshot(data.activeTrackSnapshot))
        && (!('youtubeUrl' in data) || data.youtubeUrl == null || (data.youtubeUrl is string && data.youtubeUrl.size() >= 0 && data.youtubeUrl.size() <= 500))
        && (!('youtubeId' in data) || data.youtubeId == null || (data.youtubeId is string && data.youtubeId.size() >= 0 && data.youtubeId.size() <= 64))
        && (!('showVideoInOverlay' in data) || data.showVideoInOverlay == null || data.showVideoInOverlay is bool)
        && (!('streamKey' in data) || data.streamKey == null || (data.streamKey is string && data.streamKey.size() >= 0 && data.streamKey.size() <= 128))
        && isValidId(data.hostId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.votingOpen is bool
        && data.isPlaying is bool
        && (!('isMuted' in data) || data.isMuted == null || data.isMuted is bool)
        && data.playbackPosition is number && data.playbackPosition >= 0 && data.playbackPosition <= 86400
        && data.showObsOverlay is bool
        && data.obsTheme is string && data.obsTheme.size() <= 20 && data.obsTheme in ['dark', 'neon', 'minimal', 'compact']
        && (!('liveExpertDraft' in data) || data.liveExpertDraft == null || isValidCriteriaScores(data.liveExpertDraft))
        && (!('viewersCount' in data) || (data.viewersCount is number && data.viewersCount >= 0 && data.viewersCount <= 1000000))
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules: /admins/{adminId}
    // =========================================================================
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if false;
    }

    // =========================================================================
    // Collection Rules: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isValidId(userId) || existing().xp >= 0 || existing().role in ['viewer', 'vip', 'moderator', 'expert', 'streamer', 'admin'];

      allow create: if isVerified()
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && request.auth.uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().role == 'viewer' && incoming().xp == 0 && incoming().voteWeight == 1.0) ||
          isAdmin()
        );

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          // Action 1: Owner updates public profile display fields or XP/level/helpfulVotesReceived/reviewsCount (cannot self-promote role/voteWeight)
          (
            request.auth.uid == userId
            && incoming().updatedAt == request.time
            && incoming().role == existing().role
            && incoming().voteWeight == existing().voteWeight
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'avatarUrl', 'xp', 'level', 'reviewsCount', 'helpfulVotesReceived', 'updatedAt'
            ])
          ) ||
          // Action 2: Authenticated user updates review author's XP, level, and helpfulVotesReceived on helpful vote toggle while role and voteWeight remain immutable
          (
            request.auth.uid != userId
            && incoming().updatedAt == request.time
            && incoming().role == existing().role
            && incoming().voteWeight == existing().voteWeight
            && incoming().displayName == existing().displayName
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'xp', 'level', 'helpfulVotesReceived', 'updatedAt'
            ])
          ) ||
          // Action 3: Admin manages role, XP, level, and voteWeight
          (
            (incoming().updatedAt == request.time || incoming().updatedAt == existing().updatedAt)
            && isAdmin()
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // =========================================================================
    // Collection Rules: /tracks/{trackId}
    // =========================================================================
    match /tracks/{trackId} {
      // 1. Public read & list for all users (including guests and OBS) for active/catalog statuses
      allow get: if isValidId(trackId);
      allow list: if isValidId(trackId) || existing().communityVotesCount >= 0 || existing().status in [
          'in_queue', 'on_air', 'reviewed', 'community_catalog',
          'queued', 'playing', 'reviewing'
        ] || (isSignedIn() && existing().submittedBy == request.auth.uid);

      // 2. Track creation: ONLY allowed for users with roles ['admin', 'streamer', 'expert', 'moderator']
      // Ordinary listeners ('viewer', 'vip') CANNOT create documents in /tracks
      allow create: if isVerified()
        && isValidId(trackId)
        && isValidTrack(incoming(), trackId)
        && incoming().submittedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().status in ['pending', 'in_queue', 'community_catalog', 'on_air']
            && incoming().communityVotesCount == 0
            && (!('expertScore' in incoming()) || incoming().expertScore == null)
            && (!('communityScore' in incoming()) || incoming().communityScore == null)
            && (!('metaScore' in incoming()) || incoming().metaScore == null)
            && canPublishTrack()
          ) ||
          isAdmin()
        );

      // 3. Track update: submitter metadata edit, community rating recalculation on review, or admin/host control
      allow update: if isVerified()
        && isValidId(trackId)
        && isValidTrack(incoming(), trackId)
        && incoming().id == existing().id
        && incoming().submittedBy == existing().submittedBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Submitter updates track metadata while still pending or in_queue
          (
            !(existing().status in ['reviewed', 'rejected'])
            && request.auth.uid == existing().submittedBy
            && existing().status in ['pending', 'in_queue']
            && incoming().status in ['pending', 'in_queue', 'on_air']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'artist', 'artistId', 'coverUrl', 'audioUrl', 'sourceUrl', 'youtubeUrl', 'youtubeId', 'genre', 'status', 'updatedAt'
            ])
          ) ||
          // Action 2: Community rating, batch Top-24 rank recalculation, or Studio verdict/status update
          (
            existing().status in ['in_queue', 'on_air', 'reviewed', 'community_catalog', 'queued', 'playing', 'reviewing']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'youtubeUrl', 'youtubeId', 'expertScore', 'expertTotalScore', 'communityScore', 'communityTotalScore',
              'peopleScore', 'communityVotesCount', 'reviewsCount', 'metaScore',
              'currentRank', 'previousRank', 'lastRankUpdate', 'criteriaBreakdown',
              'updatedAt'
            ])
          ) ||
          // Action 3: Admin / Host full update
          isAdmin()
        );

      allow delete: if isValidId(trackId) && isAdmin();

      // =======================================================================
      // Subcollection Rules: /tracks/{trackId}/reviews/{reviewId}
      // =======================================================================
      match /reviews/{reviewId} {
        // 4. Public read & list for all users; allow helpfulCount increment
        allow get: if isValidId(trackId) && isValidId(reviewId);
        allow list: if isValidId(trackId) || existing().trackId == trackId;

        allow create: if isVerified()
          && isValidId(trackId)
          && isValidId(reviewId)
          && isValidReview(incoming(), trackId, reviewId)
          && incoming().authorId == request.auth.uid
          && incoming().helpfulCount in [0, 1]
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/tracks/$(trackId));

        allow update: if isVerified()
          && isValidId(trackId)
          && isValidId(reviewId)
          && isValidReview(incoming(), trackId, reviewId)
          && incoming().id == existing().id
          && incoming().trackId == existing().trackId
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && (
            (
              request.auth.uid != existing().authorId
              && incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount', 'helpfulVoterIds'])
              && (
                (
                  incoming().helpfulCount == existing().helpfulCount + 1
                  && request.auth.uid in incoming().helpfulVoterIds
                ) ||
                (
                  incoming().helpfulCount == existing().helpfulCount - 1
                  && !(request.auth.uid in incoming().helpfulVoterIds)
                )
              )
            ) ||
            isAdmin()
          );

        allow delete: if isValidId(trackId) && isValidId(reviewId) && (
          isAdmin() || (isSignedIn() && existing().authorId == request.auth.uid)
        );
      }
    }

    // =========================================================================
    // Collection Group Rules: /{path=**}/reviews/{reviewId}
    // =========================================================================
    match /{path=**}/reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if isValidId(reviewId) || existing().helpfulCount >= 0 || existing().totalScore >= 0;
    }

    // =========================================================================
    // Collection Rules: /live_sessions/{sessionId} & /liveSessions/{sessionId}
    // =========================================================================
    match /live_sessions/{sessionId} {
      // Public read for OBS Browser Source (unauthenticated CEF) and all viewers
      allow get: if isValidId(sessionId);
      allow list: if isValidId(sessionId) || existing().isLive == true || existing().isLive == false;

      allow create: if isVerified()
        && isValidId(sessionId)
        && isValidLiveSession(incoming(), sessionId)
        && incoming().updatedAt == request.time
        && (isAdmin() || isStreamer());

      // 5. Session host / Studio control: ONLY admin or streamer can update live_sessions
      allow update: if isVerified()
        && isValidId(sessionId)
        && isValidLiveSession(incoming(), sessionId)
        && (!('id' in existing()) || incoming().id == existing().id)
        && incoming().updatedAt == request.time
        && (isAdmin() || isStreamer())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'isLive', 'streamStatus', 'activeTrackId', 'activeTrackSnapshot',
            'youtubeUrl', 'youtubeId', 'showVideoInOverlay', 'streamKey',
            'hostId', 'title', 'votingOpen', 'isPlaying', 'isMuted', 'playbackPosition',
            'showObsOverlay', 'obsTheme', 'liveExpertDraft',
            'viewersCount', 'updatedAt'
          ]) ||
          isAdmin()
        );

      allow delete: if isValidId(sessionId) && (isAdmin() || isStreamer());
    }

    match /liveSessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if isSignedIn() && existing().hostId == request.auth.uid;

      allow create: if isVerified()
        && isValidId(sessionId)
        && isValidLiveSession(incoming(), sessionId)
        && incoming().updatedAt == request.time
        && (isAdmin() || isStreamer())
        && (incoming().hostId == request.auth.uid || isAdmin())
        && (exists(/databases/$(database)/documents/users/$(incoming().hostId)) || isAdmin());

      allow update: if isVerified()
        && isValidId(sessionId)
        && isValidLiveSession(incoming(), sessionId)
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && (isAdmin() || isStreamer())
        && (
          (
            request.auth.uid == existing().hostId
            && incoming().hostId == existing().hostId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'isLive', 'streamStatus', 'activeTrackId', 'activeTrackSnapshot',
              'youtubeUrl', 'youtubeId', 'showVideoInOverlay', 'streamKey',
              'title', 'votingOpen', 'isPlaying', 'isMuted', 'playbackPosition',
              'showObsOverlay', 'obsTheme', 'liveExpertDraft',
              'viewersCount', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isValidId(sessionId) && (isAdmin() || isStreamer());
    }
  }
}
